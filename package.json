{
  "name": "y-reticulum",
  "version": "0.5.0",
  "description": "Reticulum provider for Yjs",
  "keywords": [
    "reticulum",
    "rns",
    "yjs"
  ],
  "homepage": "https://github.com/bergie/y-reticulum#readme",
  "bugs": {
    "url": "https://github.com/bergie/y-reticulum/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/bergie/y-reticulum.git"
  },
  "license": "EUPL-1.2",
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "type": "module",
  "main": "src/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "rm -rf dist && npm run types",
    "lint": "npx @biomejs/biome check --use-editorconfig=true src/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write src/ test/",
    "types": "tsc",
    "test": "node --test --test-force-exit --test-timeout 5000 test/*.js test/**/*.js",
    "test:deno": "deno test --no-check --allow-net --allow-env --allow-read=.,node_modules --allow-write=node_modules test/*.js",
    "test:bun": "bun test"
  },
  "dependencies": {
    "@digitaldefiance/bzip2-wasm": "^1.1.1",
    "@reticulum/core": "^0.9.6",
    "@reticulum/node": "^0.9.6",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "yjs": "^13.6.31"
  }
}
